--!strict
--!native
local configuration = require '@openmw-config'
local openmw = require '@openmw'
local fs = require '@dream/fs'
local archive = require '@dream-archive'
local vfs = require '@vfs'
local test = require '@jess/test'

--- The text of the file at `path`, raising the read's own message when there is none.
local function readText(path: string): string
  local text, problem = fs.readFileString(path)
  if not text then error(problem, 0) end

  return text
end


local expect = test.expect
local suite = test.new()
local scratch = assert(rawget(_G, 'scratchRoot') :: string?, 'the suite needs a host-owned scratchRoot')

local function io<Value>(value: Value?, message: string?, kind: dream_fs_ErrorKind?): Value
  if not value then error(message or tostring(kind), 0) end

  return value
end

local function fixture(name: string, source: string): (string, string)
  local directory = fs.join(scratch, 'openmw-config', name)
  io(fs.mkdir(directory, { recursive = true }))
  local path = fs.join(directory, 'openmw.cfg')
  io(fs.writeFile(path, source))
  return directory, path
end

local function read(path: string): string return io(readText(path)) end

--- What an activation that refused answered: it added nothing (nil), and this says why.
local function refusal(added: unknown, problem: string?): string
  expect(added).toBeNil()
  return problem or error('the activation gave no reason', 2)
end

suite.describe('configuration ownership', function()
  suite.it('returns detached entry and chain snapshots', function()
    local _, path = fixture('snapshots', 'content=Keep.esm\n')
    local config = configuration.new(path)
    config:entries()[1].value = 'Changed.esp'
    config:chain()[1].path = 'not-the-config'
    expect(config:values('content')).toEqual { 'Keep.esm' }
    expect(config:chain()[1].path).toBe(path)
    expect(table.isfrozen(config)).toBe(true)
    expect(function() vfs.serialize({ document = config }, 'json') end).toThrow 'function'
  end)
end)

suite.describe('explicit OpenMW context', function()
  suite.it('reads archived assets but never activates archived content files', function()
    local directory, path = fixture('archive-assets', 'data=data\nfallback-archive=Example.bsa\n')
    local data = fs.join(directory, 'data')
    io(fs.mkdir(data, { recursive = true }))
    local builder = archive.bsa.tes3.Builder.new()
    builder:addBytes('textures/example.dds', 'archived texture')
    builder:addBytes('Hidden.esp', 'archived content')
    builder:writePath(fs.join(data, 'Example.bsa'))
    local context = openmw.new(path)
    expect(buffer.tostring(context:readFile('textures/example.dds') :: buffer)).toBe 'archived texture'
    expect(context:resolve('Hidden.esp')).toBeNil()
    expect(refusal(context:activate('Hidden.esp'))).toContain "isn't in the data folders"
    expect(table.isfrozen(context)).toBe(true)
    expect(function() vfs.serialize({ context = context }, 'json') end).toThrow 'function'
  end)

  suite.it('checks every activation before mutating and checks newly written files afresh', function()
    local directory, path = fixture('activation', 'data=data\ncontent=Missing.esm\n')
    local data = fs.join(directory, 'data')
    io(fs.mkdir(data, { recursive = true }))
    io(fs.writeFile(fs.join(data, 'Mine.esp'), ''))
    local context = openmw.new(path)
    expect(refusal(context:activateAll({ 'Mine.esp', 'Typo.esp' }))).toContain "isn't in the data folders"
    expect(context:configuration():values('content')).toEqual { 'Missing.esm' }
    expect((context:activate('MISSING.ESM'))).toBe(false)
    expect((context:activate('mine.esp'))).toBe(true)
    expect((context:activate('MINE.ESP'))).toBe(false)
    io(fs.writeFile(fs.join(data, 'Late.esp'), ''))
    expect((context:activate('late.esp'))).toBe(true)
    expect(context:deactivate('MINE.ESP')).toBe(true)
  end)

  suite.it('invalidates lookup caches when configuration changes', function()
    local directory, path = fixture('invalidation', 'data=first\n')
    for _, folder in { 'first', 'second' } do
      io(fs.mkdir(fs.join(directory, folder), { recursive = true }))
      io(fs.writeFile(fs.join(directory, folder, 'Example.esp'), folder))
    end

    local context = openmw.new(path)
    expect(context:resolve('example.esp')).toBe(fs.join(directory, 'first/Example.esp'))
    context:configuration():replace('data', { 'second' })
    expect(context:resolve('EXAMPLE.ESP')).toBe(fs.join(directory, 'second/Example.esp'))
    expect(buffer.tostring(context:readFile('example.esp') :: buffer)).toBe 'second'
    context.dataDirs[1] = 'not-a-data-folder'
    expect(context.dataDirs[1]).toBe(fs.join(directory, 'second'))
    context:configuration():set('resources', 'resources')
    context:configuration():replace('data', { 'resources/vfs', 'second' })
    expect(context.writableDataDir).toBe(fs.join(directory, 'second'))
  end)

  suite.it('backs up the user bytes and skips existing backup names', function()
    local source = '# original\r\ncontent=Keep.esm\r\n'
    local _, path = fixture('backups', source)
    io(fs.writeFile(path .. '.bak', 'older'))
    local context = openmw.new(path)
    context:activate('Forced.esp', { force = true })
    local written = context:save()
    expect(written.backup).toBe(path .. '.bak1')
    expect(read(written.backup :: string)).toBe(source)
    expect(read(path .. '.bak')).toBe 'older'
    expect(configuration.new(path):values('content')).toEqual { 'Keep.esm', 'Forced.esp' }
  end)
end)

suite.describe('what a context answers', function()
  suite.it('reads its properties from the configuration, afresh each time', function()
    local directory, path =
      fixture('properties', 'encoding=win1251\nfallback-archive=First.bsa\nfallback-archive=Second.bsa\ndata=data\n')
    local context = openmw.new(path)
    expect(context.fallbackArchives).toEqual { 'First.bsa', 'Second.bsa' }
    expect(context.encoding).toBe 'win1251'
    expect(context.userConfigDir).toBe(directory)
    expect(context.dataLocal).toBeNil()
    expect(context.writableDataDir).toBe(fs.join(directory, 'data'))
    expect(((context :: unknown) :: { [string]: unknown }).nothing).toBeNil()
    context:configuration():set('data-local', 'local')
    expect(context.dataLocal).toBe(fs.join(directory, 'local'))
    expect(context.writableDataDir).toBe(fs.join(directory, 'local'))
    expect(context.dataDirs).toEqual { fs.join(directory, 'data'), fs.join(directory, 'local') }
    expect(openmw.fromConfig(context:configuration()):configuration()).toBe(context:configuration())
  end)

  suite.it('lists content with the file each name resolves to, whatever its case', function()
    local directory, path = fixture(
      'content',
      'data=first\ndata=absent\ndata=second\ncontent=Shared.esp\ncontent=ONLY.ESP\ncontent=Folder.esp\ncontent=Missing.esp\n'
    )
    local first, second = fs.join(directory, 'first'), fs.join(directory, 'second')
    io(fs.mkdir(fs.join(first, 'Folder.esp'), { recursive = true }))
    io(fs.mkdir(second, { recursive = true }))
    io(fs.writeFile(fs.join(first, 'Shared.esp'), 'first'))
    io(fs.writeFile(fs.join(first, 'Only.esp'), 'only'))
    io(fs.writeFile(fs.join(second, 'Shared.esp'), 'second'))
    local context = openmw.new(path)
    local content = context:content()
    expect(content).toEqual {
      { name = 'Shared.esp', path = fs.join(second, 'Shared.esp') },
      { name = 'ONLY.ESP', path = fs.join(first, 'Only.esp') },
      { name = 'Folder.esp' },
      { name = 'Missing.esp' },
    }

    content[1].path = 'not-the-file'
    table.remove(content)
    expect(#context:content()).toBe(4)
    expect(context:content()[1].path).toBe(fs.join(second, 'Shared.esp'))
    expect(openmw.new(select(2, fixture('no-content', 'data=first\n'))):content()).toEqual {}
  end)

  suite.it('resolves below the top level through the loose folders, by either separator', function()
    local directory, path = fixture('nested', 'data=data\n')
    local textures = fs.join(directory, 'data', 'textures')
    io(fs.mkdir(textures, { recursive = true }))
    io(fs.writeFile(fs.join(textures, 'Example.dds'), 'loose'))
    local context = openmw.new(path)
    local expected = fs.join(textures, 'Example.dds')
    expect(context:resolve('textures/example.dds')).toBe(expected)
    expect(context:resolve('TEXTURES\\EXAMPLE.DDS')).toBe(expected)
    expect(context:resolve('textures/missing.dds')).toBeNil()
    expect(context:resolve('textures')).toBeNil()
    expect(context:resolve('')).toBeNil()
  end)

  suite.it('keeps the top level it listed until it is refreshed', function()
    local directory, path = fixture('refresh', 'data=data\n')
    local data = fs.join(directory, 'data')
    io(fs.mkdir(data, { recursive = true }))
    local context = openmw.new(path)
    expect(context:resolve('Late.esp')).toBeNil()
    io(fs.writeFile(fs.join(data, 'Late.esp'), ''))
    expect(context:resolve('late.esp')).toBeNil()
    expect(context:content()).toEqual {}
    context:refresh()
    expect(context:resolve('late.esp')).toBe(fs.join(data, 'Late.esp'))
  end)

  suite.it('lists a long content list whole and in order, each name with what it resolves to', function()
    local lines = { 'data=even', 'data=odd' }
    for index = 1, 300 do table.insert(lines, `content=Plugin {index}.esp`) end

    local directory, path = fixture('long', table.concat(lines, '\n') .. '\n')
    local folders = { fs.join(directory, 'even'), fs.join(directory, 'odd') }
    for _, folder in folders do io(fs.mkdir(folder, { recursive = true })) end

    for index = 1, 300, 3 do io(fs.writeFile(fs.join(folders[index % 2 + 1], `PLUGIN {index}.ESP`), '')) end

    local context = openmw.new(path)
    local content = context:content()
    expect(#content).toBe(300)
    for index, entry in content do
      local held = if index % 3 == 1 then fs.join(folders[index % 2 + 1], `PLUGIN {index}.ESP`) else nil
      expect(entry).toEqual { name = `Plugin {index}.esp`, path = held }
      expect(context:resolve(entry.name)).toBe(held)
    end
  end)
end)

suite.describe('activation', function()
  suite.it('activates a batch in the order given, once for a name whatever its case', function()
    local directory, path = fixture('batch', 'data=absent\ndata=first\ndata=second\ncontent=Keep.esm\n')
    local first, second = fs.join(directory, 'first'), fs.join(directory, 'second')
    io(fs.mkdir(fs.join(first, 'Folder.esp'), { recursive = true }))
    io(fs.mkdir(second, { recursive = true }))
    io(fs.writeFile(fs.join(first, 'Early.esp'), ''))
    io(fs.writeFile(fs.join(first, 'Early.esp.bak'), ''))
    io(fs.writeFile(fs.join(second, 'Later.esp'), ''))
    local context = openmw.new(path)
    local batch = { 'LATER.esp', 'keep.ESM', 'early.esp', 'Later.ESP', 'EARLY.ESP', 'Early.ESP.BAK' }
    expect((context:activateAll(batch))).toEqual { 'LATER.esp', 'early.esp', 'Early.ESP.BAK' }
    expect(context:configuration():values('content')).toEqual { 'Keep.esm', 'LATER.esp', 'early.esp', 'Early.ESP.BAK' }
    expect((context:activateAll({}))).toEqual {}
    expect((context:activateAll(batch))).toEqual {}
  end)

  suite.it('refuses a name no data folder holds as a file, and names it', function()
    local directory, path = fixture('refusals', 'data=data\ncontent=Keep.esm\n')
    local data = fs.join(directory, 'data')
    io(fs.mkdir(fs.join(data, 'Folder.esp'), { recursive = true }))
    io(fs.writeFile(fs.join(data, 'Mine.esp'), ''))
    local context = openmw.new(path)
    expect(refusal(context:activate('Folder.esp'))).toContain "openmw: 'Folder.esp' isn't in the data folders; check the name, or pass { force = true }"
    expect(refusal(context:activate('Mine.es'))).toContain "openmw: 'Mine.es' isn't in the data folders"
    expect(refusal(context:activate('Mine.esp2'))).toContain "openmw: 'Mine.esp2' isn't in the data folders"
    expect(refusal(context:activateAll({ 'Mine.esp', 'Unlisted.esp', 'Folder.esp' }))).toContain "openmw: 'Unlisted.esp' isn't"
    expect(refusal(context:activateAll({ 'Mine.esp', ' Mine.esp' }))).toContain 'surrounding whitespace'
    expect(context:configuration():values('content')).toEqual { 'Keep.esm' }
    expect((context:activateAll({ 'Folder.esp', 'Unlisted.esp', 'FOLDER.ESP' }, { force = true }))).toEqual { 'Folder.esp', 'Unlisted.esp' }
    expect(refusal(context:activate('Other.esp', { force = false }))).toContain "openmw: 'Other.esp' isn't"
    expect(context:configuration():values('content')).toEqual { 'Keep.esm', 'Folder.esp', 'Unlisted.esp' }
  end)

  suite.it('refuses an option it does not know before it looks at a name', function()
    local _, path = fixture('options', 'content=Keep.esm\n')
    local context = openmw.new(path)
    local unknown = ({ forced = true } :: unknown) :: { force: boolean? }
    local mistyped = ({ force = 'yes' } :: unknown) :: { force: boolean? }
    expect(function() context:activate('Keep.esm', unknown) end).toThrow "openmw: unknown activation option 'forced'"
    expect(function() context:activateAll({}, mistyped) end).toThrow 'openmw: force needs a boolean'
  end)

  suite.it('deactivates every spelling of a name, and nothing when none is active', function()
    local _, path = fixture('spellings', 'content=Mine.esp\ncontent=Other.esp\ncontent=MINE.ESP\ncontent=Mine.esp.bak\n')
    local context = openmw.new(path)
    expect(context:deactivate('Absent.esp')).toBe(false)
    expect(context:deactivate('mine.esp')).toBe(true)
    expect(context:configuration():values('content')).toEqual { 'Other.esp', 'Mine.esp.bak' }
    expect(context:deactivate('mine.esp')).toBe(false)
    expect(context:deactivate('OTHER.ESP')).toBe(true)
    expect(context:deactivate('MINE.esp.BAK')).toBe(true)
    expect(context:configuration():values('content')).toEqual {}
    expect(context:deactivate('Other.esp')).toBe(false)
  end)

  suite.it('reaches a data folder only for a name the folders before it lack, and raises what listing it does', function()
    local directory, path = fixture('reach', 'data=first\ndata=blocked\ndata=third\ncontent=Keep.esm\n')
    local first, third = fs.join(directory, 'first'), fs.join(directory, 'third')
    io(fs.mkdir(first, { recursive = true }))
    io(fs.mkdir(third, { recursive = true }))
    for _, name in { 'Early.esp', 'Also.esp', 'Spare.esp' } do io(fs.writeFile(fs.join(first, name), '')) end

    io(fs.writeFile(fs.join(directory, 'blocked'), 'a file where a data folder belongs'))
    io(fs.writeFile(fs.join(third, 'Later.esp'), ''))
    local context = openmw.new(path)
    expect((context:activateAll({ 'early.esp', 'ALSO.ESP' }))).toEqual { 'early.esp', 'ALSO.ESP' }
    expect(refusal(context:activateAll({ 'Spare.esp', 'Later.esp' }))).toContain 'dream.fs.list'
    expect(refusal(context:activateAll({ 'Later.esp', 'Spare.esp' }))).toContain 'dream.fs.list'
    expect(refusal(context:activate('Nowhere.esp'))).toContain 'dream.fs.list'
    expect(context:configuration():values('content')).toEqual { 'Keep.esm', 'early.esp', 'ALSO.ESP' }
    expect((context:activateAll({ 'Later.esp', 'Nowhere.esp' }, { force = true }))).toEqual { 'Later.esp', 'Nowhere.esp' }
    expect((context:activate('SPARE.ESP'))).toBe(true)
  end)

  suite.it('folds the case of ASCII letters and of no others, for a name of any length', function()
    local _, path = fixture('folding', 'content=Éclair.esp\ncontent=Plain.esp\n')
    local context = openmw.new(path)
    expect((context:activate('ÉCLAIR.ESP', { force = true }))).toBe(false)
    expect(context:deactivate('éclair.esp')).toBe(false)
    expect((context:activate('éclair.esp', { force = true }))).toBe(true)
    expect(context:configuration():values('content')).toEqual { 'Éclair.esp', 'Plain.esp', 'éclair.esp' }
    expect(context:deactivate('ÉCLAIR.esp')).toBe(true)
    expect(context:deactivate('plain.es')).toBe(false)
    expect(context:deactivate('plain.espx')).toBe(false)
    expect(context:configuration():values('content')).toEqual { 'Plain.esp', 'éclair.esp' }
  end)
end)

return suite
